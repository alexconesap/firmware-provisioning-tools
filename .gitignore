# Read-only symlinks into other local repos; never committed.
/__REFERENCE__/

# Per-developer overrides, same convention as the firmware repos
# (<module>/.settings is tracked, <module>/.local.settings is not).
*.local.settings

# macOS / Windows cruft
.DS_Store
Thumbs.db

# Runtime cache/staging used by flash.sh/flash.ps1 — downloaded or
# pre-staged binaries, per-run logs. Mirrors <project>/code/build/<module>/
# from the firmware repos, so a whole build/ folder can be copied straight
# in for pre-staging without renaming anything
/projects/
