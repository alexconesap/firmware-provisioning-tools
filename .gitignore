# Read-only symlinks into other local repos; never committed.
/__REFERENCE__/

# Redundant with /projects/* below (everything under projects/ is already
# ignored) but kept in case .local.settings ever shows up outside projects/.
*.local.settings

# macOS / Windows cruft
.DS_Store
Thumbs.db

# Nothing under projects/ is tracked (settings, partitions.csv, build/ output
# — all of it is per-machine/per-checkout, not part of this repo). Keep the
# folder itself present in a fresh clone via projects/.gitkeep, which is the
# one file exempted below.
/projects/*
!/projects/.gitkeep
